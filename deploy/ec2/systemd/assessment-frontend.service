[Unit]
Description=Assessment frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=assessment
Group=assessment
WorkingDirectory=/opt/assessment/current/frontend
Environment=NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000 NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/node /opt/assessment/current/frontend/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/assessment /opt/assessment/current/frontend/.next/cache
StandardOutput=append:/var/log/assessment/frontend.log
StandardError=append:/var/log/assessment/frontend.log

[Install]
WantedBy=multi-user.target
