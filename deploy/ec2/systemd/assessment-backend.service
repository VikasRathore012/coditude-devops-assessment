[Unit]
Description=Assessment backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=assessment
Group=assessment
WorkingDirectory=/opt/assessment/current/backend
EnvironmentFile=/etc/assessment/backend.env
ExecStart=/opt/assessment/current/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000 --no-server-header
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/assessment /opt/assessment/current/frontend/.next/cache
StandardOutput=append:/var/log/assessment/backend.log
StandardError=append:/var/log/assessment/backend.log

[Install]
WantedBy=multi-user.target
